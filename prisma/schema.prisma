// My-ERP Prisma schema — single source of truth (mode: repo-prisma).
// Path is fixed by docs/project/db-ssot.json; refresh the DB context contract with
//   node .ai/scripts/ctl-db-ssot.mjs sync-to-context
//
// Hard constraints reflected here:
//  - Money is NUMERIC/Decimal, never float (see finance tables in P2+).
//  - Accounting archives + audit are append-only: no physical delete, ever.
//  - Multi-tenant rows carry ledgerBookId/orgId for app-scope + Postgres RLS (P0b).
//
// P0a ships only the append-only AuditRecord. Platform tables (Organization,
// Membership, Invitation, LedgerBook, AccountingPeriod) land in P0b/P1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Append-only operation audit log (>= 1y retention). Never updated or deleted.
model AuditRecord {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @map("actor_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  ledgerBookId String?  @map("ledger_book_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ledgerBookId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_record")
}

// ---- P1: organization / membership / ledger book (platform tenancy) ----
// Two-level scoping: these platform tables are ORG-scoped (RLS by app.current_org);
// financial rows (accounts/vouchers, P2+) are LEDGER-scoped (RLS by app.current_ledger).

/// An organization owns ledger books and members (邀请制加入，账套归组织).
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships    Membership[]
  ledgerBooks    LedgerBook[]
  invitations    Invitation[]
  workItems      WorkItem[]
  workItemEvents WorkItemEvent[]
  outboxEvents   OutboxEvent[]
  intakes        Intake[]
  attachments    Attachment[]

  @@map("organization")
}

/// An invitation to join an org with a role (邀请制；禁止自助加入). State machine:
/// pending → accepted | revoked | expired. The token is a secret; accepting it
/// (with a matching email) creates the Membership.
model Invitation {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  invitedEmail String    @map("invited_email")
  role         String
  token        String    @unique
  status       String    @default("pending")
  invitedBy    String    @map("invited_by")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedBy   String?   @map("accepted_by")
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("invitation")
}

/// A user's role in an organization — the single source of truth for RBAC.
/// One membership per (org, user); invitation-only (P1b).
model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id")
  role      String
  email     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("membership")
}

/// A ledger book (账套) under an organization. Org-scoped platform entity; its
/// financial rows are ledger-scoped by this id. baseCurrency 2dp; fiscalYear =
/// 启用年度; periodStructure "12+1" = 自然年 12 期 + 年结期.
model LedgerBook {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  name             String
  baseCurrency     String   @map("base_currency")
  fiscalYear       Int      @map("fiscal_year")
  periodStructure  String   @default("12+1") @map("period_structure")
  active           Boolean  @default(true)
  /// 单人模式（SoD 例外）：显式开启后允许制单人过账自己的凭证（强制二次确认 + 留痕）。
  singlePersonMode Boolean  @default(false) @map("single_person_mode")
  /// 启用期间（期初建账设定），如 "2026-06"；null = 未建账。
  openingPeriod    String?  @map("opening_period")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  accounts        Account[]
  vouchers        JournalVoucher[]
  openingBalances OpeningBalance[]
  workItems       WorkItem[]
  workItemEvents  WorkItemEvent[]
  outboxEvents    OutboxEvent[]
  intakes         Intake[]
  attachments     Attachment[]
  periodCloses    PeriodClose[]
  cashFlowItems   CashFlowItem[]

  @@index([orgId])
  @@map("ledger_book")
}

/// A platform work item (待办/工作项). Current queue state only; source business
/// entities (voucher/payment/etc.) remain the business-state source of truth.
/// orgId is mandatory; ledgerBookId is set for finance ledger-scoped sources.
model WorkItem {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String    @map("org_id") @db.Uuid
  ledgerBookId    String?   @map("ledger_book_id") @db.Uuid
  moduleKey       String    @map("module_key")
  workflowKey     String    @map("workflow_key")
  workflowVersion String    @map("workflow_version")
  workItemType    String    @map("work_item_type")
  sourceType      String    @map("source_type")
  sourceId        String    @map("source_id") @db.Uuid
  dedupeKey       String    @map("dedupe_key")
  status          String
  subStatus       String    @map("sub_status")
  priority        String    @default("normal")
  assignedRole    String    @map("assigned_role")
  assigneeUserId  String?   @map("assignee_user_id")
  claimedAt       DateTime? @map("claimed_at") @db.Timestamptz(6)
  availableAt     DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  dueAt           DateTime? @map("due_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  canceledAt      DateTime? @map("canceled_at") @db.Timestamptz(6)
  createdBy       String    @map("created_by")
  completedBy     String?   @map("completed_by")
  version         Int       @default(1)
  titleKey        String    @map("title_key")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledgerBook   LedgerBook?     @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)
  events       WorkItemEvent[]
  outboxEvents OutboxEvent[]

  @@index([orgId, status])
  @@index([ledgerBookId, status])
  @@index([assigneeUserId, status])
  @@index([assignedRole, status])
  @@index([sourceType, sourceId])
  @@index([dedupeKey])
  @@map("work_item")
}

/// Append-only transition history for WorkItem. Never updated or deleted.
model WorkItemEvent {
  id           String   @id @default(uuid()) @db.Uuid
  workItemId   String   @map("work_item_id") @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  ledgerBookId String?  @map("ledger_book_id") @db.Uuid
  eventType    String   @map("event_type")
  actionKey    String?  @map("action_key")
  fromStatus   String?  @map("from_status")
  toStatus     String?  @map("to_status")
  actorId      String   @map("actor_id")
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workItem     WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledgerBook   LedgerBook?  @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)

  @@index([workItemId, createdAt])
  @@index([orgId, createdAt])
  @@index([ledgerBookId, createdAt])
  @@map("work_item_event")
}

/// Transactional metadata-only outbox event. Payloads sent toward My-Chat MUST
/// never include financial details; detailed context is fetched from ERP after
/// authorization.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  ledgerBookId  String?   @map("ledger_book_id") @db.Uuid
  workItemId    String?   @map("work_item_id") @db.Uuid
  eventType     String    @map("event_type")
  sourceType    String    @map("source_type")
  sourceId      String?   @map("source_id") @db.Uuid
  payload       Json
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledgerBook   LedgerBook?  @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)
  workItem     WorkItem?    @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([orgId, status, createdAt])
  @@index([ledgerBookId, status, createdAt])
  @@index([workItemId])
  @@map("outbox_event")
}

/// A journal voucher (记账凭证). Ledger-scoped. Money is NUMERIC (never float).
/// State machine: draft → pending → posted → reversed (see service layer).
/// Never physically deleted (无 DELETE 策略); corrections via reversal (红冲).
model JournalVoucher {
  id           String    @id @default(uuid()) @db.Uuid
  ledgerBookId String    @map("ledger_book_id") @db.Uuid
  no           String
  date         DateTime  @db.Date
  period       String
  status       String    @default("draft")
  summary      String
  totalDebit   Decimal   @default(0) @map("total_debit") @db.Decimal(18, 2)
  totalCredit  Decimal   @default(0) @map("total_credit") @db.Decimal(18, 2)
  maker        String
  checker      String?
  postedAt     DateTime? @map("posted_at") @db.Timestamptz(6)
  /// The original voucher this one reverses (set on a reversal voucher). Unique:
  /// a voucher can be reversed at most once, even under concurrent requests.
  reversalOf   String?   @unique @map("reversal_of") @db.Uuid
  /// The reversal voucher created from this one (set on the original when reversed).
  reversedBy   String?   @map("reversed_by") @db.Uuid
  attachments  Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ledgerBook LedgerBook         @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)
  lines      JournalEntryLine[]

  @@unique([ledgerBookId, no])
  @@index([ledgerBookId, status])
  @@map("journal_voucher")
}

/// An opening balance (期初余额) per account for a ledger book. Ledger-scoped.
/// Exactly one of debit/credit; the set must balance (启用期试算平衡). The derived
/// ledger seeds 期初 from these.
model OpeningBalance {
  id           String   @id @default(uuid()) @db.Uuid
  ledgerBookId String   @map("ledger_book_id") @db.Uuid
  accountCode  String   @map("account_code")
  accountName  String   @map("account_name")
  debit        Decimal? @db.Decimal(18, 2)
  credit       Decimal? @db.Decimal(18, 2)

  ledgerBook LedgerBook @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)

  @@unique([ledgerBookId, accountCode])
  @@index([ledgerBookId])
  @@map("opening_balance")
}

/// A single debit-or-credit line of a voucher. ledgerBookId is denormalized so
/// lines are directly ledger-scoped by RLS. Exactly one of debit/credit is set.
model JournalEntryLine {
  id           String   @id @default(uuid()) @db.Uuid
  voucherId    String   @map("voucher_id") @db.Uuid
  ledgerBookId String   @map("ledger_book_id") @db.Uuid
  lineNo       Int      @map("line_no")
  accountCode  String   @map("account_code")
  accountName  String   @map("account_name")
  summary      String
  debit        Decimal? @db.Decimal(18, 2)
  credit       Decimal? @db.Decimal(18, 2)
  aux          Json?
  cashFlowItem String?  @map("cash_flow_item")

  voucher JournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
  @@index([ledgerBookId])
  @@map("journal_entry_line")
}

/// A chart-of-accounts entry (会计科目) within a ledger book. LEDGER-scoped via
/// RLS (app.current_ledger). Multi-level by code (升序 = 树前序); only leaf
/// accounts carry postings. auxTypes = 辅助核算 (往来/部门/项目).
model Account {
  id           String   @id @default(uuid()) @db.Uuid
  ledgerBookId String   @map("ledger_book_id") @db.Uuid
  code         String
  name         String
  category     String
  direction    String
  parentCode   String?  @map("parent_code")
  level        Int
  isLeaf       Boolean  @default(true) @map("is_leaf")
  auxTypes     String[] @default([]) @map("aux_types")
  active       Boolean  @default(true)
  /// 默认现金流量项目 (T-006 M3b) — auto-suggest for the non-cash line of a cash voucher.
  defaultCashFlowItem String? @map("default_cash_flow_item")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ledgerBook LedgerBook @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)

  @@unique([ledgerBookId, code])
  @@index([ledgerBookId])
  @@map("account")
}

/// A cash flow item (现金流量项目) for the direct-method CF statement (T-006 M3b).
/// Tagged onto the non-cash lines of cash-involved vouchers (JournalEntryLine.cashFlowItem).
/// Ledger-scoped (like account/voucher).
model CashFlowItem {
  id           String   @id @default(uuid()) @db.Uuid
  ledgerBookId String   @map("ledger_book_id") @db.Uuid
  code         String
  name         String
  activity     String // operating | investing | financing
  direction    String // inflow | outflow
  sort         Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ledgerBook LedgerBook @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)

  @@unique([ledgerBookId, code])
  @@index([ledgerBookId])
  @@map("cash_flow_item")
}

/// A stored capture attachment (票据/凭据原件) for T-004 intake. Bytes live in
/// object storage (referenced by storageKey), never inline. Append-only intent
/// (accounting archive). Ledger-scoped (org + ledger via RLS).
model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  ledgerBookId String   @map("ledger_book_id") @db.Uuid
  storageKey   String   @map("storage_key")
  contentType  String   @map("content_type")
  byteSize     Int      @map("byte_size")
  sha256       String
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledgerBook   LedgerBook   @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)
  intakes      Intake[]

  @@index([orgId])
  @@index([ledgerBookId])
  @@map("attachment")
}

/// A capture intake (业务事件捕获) — domain-agnostic. An economic event (photo /
/// pdf / text) captured from web/chat, extracted, drafted into a voucher, then
/// confirmed. Ledger-scoped (org + ledger via RLS). `extraction` JSON and the
/// attachment are ERP-only financial detail; never sent to My-Chat. `version`
/// guards the one-shot extracted→drafted transition (optimistic concurrency).
model Intake {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  ledgerBookId String   @map("ledger_book_id") @db.Uuid
  source       String   @default("web")
  kind         String
  status       String   @default("received")
  attachmentId String?  @map("attachment_id") @db.Uuid
  extraction   Json?
  confidence   Decimal? @db.Decimal(4, 3)
  needsReview  Boolean  @default(false) @map("needs_review")
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id") @db.Uuid
  channelRef   String?  @map("channel_ref")
  createdBy    String   @map("created_by")
  version      Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ledgerBook   LedgerBook   @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)
  attachment   Attachment?  @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([ledgerBookId, status])
  @@index([targetType, targetId])
  @@map("intake")
}

/// A period-close record (期末结账) — T-006. One row per (ledger, period) once it
/// has been closed. 结转损益 posts a voucher (损益类 → 本年利润) and locks the period;
/// 反结账 红冲 that voucher and reopens. Ledger-scoped (org + ledger via RLS).
model PeriodClose {
  id             String    @id @default(uuid()) @db.Uuid
  ledgerBookId   String    @map("ledger_book_id") @db.Uuid
  period         String
  status         String    @default("closed")
  closeVoucherId String?   @map("close_voucher_id") @db.Uuid
  closedBy       String?   @map("closed_by")
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  reopenedBy     String?   @map("reopened_by")
  reopenedAt     DateTime? @map("reopened_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  ledgerBook LedgerBook @relation(fields: [ledgerBookId], references: [id], onDelete: Cascade)

  @@unique([ledgerBookId, period])
  @@index([ledgerBookId, status])
  @@map("period_close")
}
