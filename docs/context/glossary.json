{
  "version": 1,
  "updatedAt": "2026-06-05T00:00:00Z",
  "terms": [
    {
      "term": "账套",
      "definition": "一套独立、自成体系的会计账簿与核算规则集合（本位币、会计期间、科目体系），是财务数据的隔离边界（多租户单元）。账套归属组织，一组织可建多账套。",
      "scope": "global",
      "aliases": ["Ledger Book", "账簿主体", "Account Set"],
      "see_also": ["组织", "会计期间"]
    },
    {
      "term": "会计科目",
      "definition": "对资产、负债、所有者权益、成本、损益进行分类核算的项目，具编码、名称、类别与借贷方向；支持多级与辅助核算。",
      "scope": "global",
      "aliases": ["Account", "科目", "Chart of Accounts"],
      "see_also": ["辅助核算"]
    },
    {
      "term": "记账凭证",
      "definition": "记录一笔经济业务、由若干借贷分录组成且借贷必相等的会计单据。状态：草稿/已审核/已过账/已红冲。",
      "scope": "global",
      "aliases": ["Journal Voucher", "凭证"],
      "see_also": ["分录", "过账", "红冲"]
    },
    {
      "term": "分录",
      "definition": "凭证中的一行，含科目、借/贷方向、金额与辅助核算；同一凭证借方合计等于贷方合计。",
      "scope": "global",
      "aliases": ["Journal Entry Line", "分录行"]
    },
    {
      "term": "过账",
      "definition": "将已审核凭证登记入总账/明细账并更新科目余额的动作；过账后影响余额，纠错通过红冲。",
      "scope": "global",
      "aliases": ["Posting", "记账"]
    },
    {
      "term": "红冲",
      "definition": "以反向凭证冲销已过账凭证以纠错，保留完整轨迹；不是物理删除。",
      "scope": "global",
      "aliases": ["Reversal", "冲销"]
    },
    {
      "term": "科目余额",
      "definition": "某科目在某会计期间的期初、本期借贷发生额与期末余额；汇总形式为试算平衡表。",
      "scope": "global",
      "aliases": ["Account Balance", "Trial Balance", "余额表"]
    },
    {
      "term": "会计期间",
      "definition": "财务核算的时间区间（自然年、按月 12 期 + 年结期）；结账后封闭，反结账可重开。",
      "scope": "global",
      "aliases": ["Accounting Period", "期间"],
      "see_also": ["期末结账"]
    },
    {
      "term": "期末结账",
      "definition": "期末校验并结转损益、封闭当期的处理；反结账为其逆操作。",
      "scope": "global",
      "aliases": ["Period Closing", "结账"]
    },
    {
      "term": "出纳",
      "definition": "负责现金与银行资金收付、登记日记账与银行对账的岗位；不负责制单审核（职责分离）。",
      "scope": "global",
      "aliases": ["Cashier"]
    },
    {
      "term": "会计",
      "definition": "负责会计科目维护、制单/审核/过账、结账与出报表的岗位。",
      "scope": "global",
      "aliases": ["Accountant"]
    },
    {
      "term": "资金账户",
      "definition": "现金或银行存款账户，记录余额与收付流水；银行账户含开户行、账号、币种。",
      "scope": "global",
      "aliases": ["Cash Account", "银行账户"]
    },
    {
      "term": "收付款单",
      "definition": "出纳登记资金收入（收款单）或支出（付款单）的业务单据，关联往来单位与资金账户；付款需审批。",
      "scope": "global",
      "aliases": ["Receipt", "Payment", "收款单", "付款单"],
      "see_also": ["记账规则", "审批"]
    },
    {
      "term": "现金银行日记账",
      "definition": "按时间顺序逐笔登记现金或银行账户收付的明细账。",
      "scope": "global",
      "aliases": ["Cash & Bank Journal", "日记账"]
    },
    {
      "term": "银行对账",
      "definition": "将银行日记账与银行对账单逐笔勾对、识别未达账项并编制余额调节表的过程（v1.1）。",
      "scope": "global",
      "aliases": ["Bank Reconciliation", "对账"]
    },
    {
      "term": "往来单位",
      "definition": "与本单位发生资金/业务往来的对象，含客户、供应商、员工；作为辅助核算与收付款对象。",
      "scope": "global",
      "aliases": ["Business Partner", "客商", "往来对象"]
    },
    {
      "term": "辅助核算",
      "definition": "在会计科目之外，按往来单位/部门/项目等维度对发生额与余额进行的明细核算。v1 含往来单位 + 部门 + 项目三维。",
      "scope": "global",
      "aliases": ["Auxiliary Accounting", "核算维度"]
    },
    {
      "term": "现金流量项目",
      "definition": "用于编制现金流量表（直接法）的归类项目，在涉及现金/银行的分录或收付款上打标。",
      "scope": "global",
      "aliases": ["Cash Flow Item"]
    },
    {
      "term": "期初余额",
      "definition": "系统启用时设定的起始会计期间，及该时点各科目、往来、资金账户的起始余额；启用期需试算平衡。",
      "scope": "global",
      "aliases": ["Opening Balance", "期初建账", "启用期"]
    },
    {
      "term": "记账规则",
      "definition": "将业务单据（如收付款单）映射为记账凭证的可配置规则，用于自动生成凭证草稿；生成的凭证仍需会计复核过账。",
      "scope": "global",
      "aliases": ["Posting Rule", "自动凭证规则"]
    },
    {
      "term": "审批",
      "definition": "对付款/凭证等单据的多级审核动作；审批引擎与状态机归 ERP。",
      "scope": "global",
      "aliases": ["Approval"],
      "see_also": ["审批策略"]
    },
    {
      "term": "审批策略",
      "definition": "定义审批层级与金额阈值分级的可配置规则，应用于付款及可选凭证审批；策略变更留痕。",
      "scope": "global",
      "aliases": ["Approval Policy", "分级审批规则"]
    },
    {
      "term": "职责分离",
      "definition": "同一笔业务的不同控制环节由不同人执行的内控原则，如制单≠审核、付款发起≠审批。",
      "scope": "global",
      "aliases": ["SoD", "Segregation of Duties", "不相容职务分离"],
      "see_also": ["单人模式"]
    },
    {
      "term": "单人模式",
      "definition": "当组织财务团队只有 1 人、无法满足职责分离时，可显式开启的降级模式；放宽 SoD 但强制二次确认并全量留痕。",
      "scope": "global",
      "aliases": ["Solo Mode", "单操作员模式"]
    },
    {
      "term": "组织",
      "definition": "财务核算的所属主体与多租户单元；账套归属于组织，个人以组织成员身份进入财务。来源于 My-Chat / Logto Organization。",
      "scope": "global",
      "aliases": ["Organization", "团队", "单位"],
      "see_also": ["邀请制", "账套"]
    },
    {
      "term": "邀请制",
      "definition": "组织成员只能由管理员/主管发起邀请、被邀请人接受后加入并被授角色的加入方式；禁止自助加入。",
      "scope": "global",
      "aliases": ["Invitation-only Membership", "邀请加入"]
    },
    {
      "term": "角色工作流",
      "definition": "以角色为中心、由待办/任务驱动的工作流组织方式；每个角色有其任务工作台与状态流转，区别于单一线性财务管道。作为可注册能力接入平台。",
      "scope": "global",
      "aliases": ["Role-based Workflow", "角色任务流", "待办工作台"]
    },
    {
      "term": "待办",
      "definition": "角色工作流中分派给某角色/某人的待处理事项（如待提交、待审批、待过账、待确认收付、待处理邀请）。",
      "scope": "global",
      "aliases": ["Task", "工作项", "任务"]
    },
    {
      "term": "票据OCR",
      "definition": "对上传的票据图片/PDF 进行光学字符识别，提取金额、往来单位、日期等字段以预填凭证草稿（v1 试点，复用通义/Dashscope 视觉 + 适配接口）。",
      "scope": "global",
      "aliases": ["Invoice OCR", "票据识别", "OCR 预填"]
    },
    {
      "term": "集成隔离护栏",
      "definition": "财务明细数据禁止进入 My-Chat 的 RAG/知识库/论坛/个性化管道，对外仅暴露通知元数据与审批回写的约束。",
      "scope": "global",
      "aliases": ["Integration Isolation Guardrail", "数据隔离护栏"]
    },
    {
      "term": "会计档案",
      "definition": "会计凭证、账簿、财务报告等需按法规长期保存的财务记录（凭证/账簿约 30 年、年报永久、月/季报 10 年）；远超操作审计日志留存。",
      "scope": "global",
      "aliases": ["Accounting Archives"]
    },
    {
      "term": "Outbox事件",
      "definition": "与业务写入同事务落库、再异步分发的领域事件，保证写入与对外通知一致（saga）；对齐 My-Chat 的 outbox/saga 模式。",
      "scope": "global",
      "aliases": ["Outbox Event", "发件箱事件"]
    },
    {
      "term": "模块",
      "definition": "ERP 平台中可独立演进的业务能力单元；v1 仅实现 finance 模块，并预留注册/扩展机制。",
      "scope": "global",
      "aliases": ["ERP Module", "能力", "Capability"]
    },
    {
      "term": "Logto SSO",
      "definition": "My-Chat 生态使用的 OIDC 身份提供方；ERP 复用其完成单点登录与身份来源（组织/成员/邀请）。",
      "scope": "global",
      "aliases": ["OIDC", "统一身份"]
    }
  ]
}
