# Copy to .env for local development. Aligned with env/contract.yaml + infra/docker-compose.yml.
APP_ENV=dev
SERVICE_NAME=my-erp-api
PORT=8000

# Postgres (matches infra/docker-compose.yml — host port 5433 to avoid clashing with other local PG)
DATABASE_URL=postgresql://myerp:myerp@localhost:5433/myerp?schema=public

# Redis (placeholder for M1; workers wired in later milestones)
REDIS_URL=redis://localhost:6379

# Web → API
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
