{
  "name": "my-erp",
  "version": "0.1.0",
  "description": "可嵌入 My-Chat 生态的模块化智能 ERP 平台；v1 聚焦财务模块（会计总账 + 出纳资金），组织级 + 邀请制 + 严格权限，按角色组织工作流。",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma && pnpm --filter @my-erp/api-client codegen",
    "dev": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter \"@my-erp/api\" --filter \"@my-erp/web\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages",
    "lint:css": "stylelint \"apps/**/*.css\" \"packages/**/*.css\"",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:sync-context": "node .ai/scripts/ctl-db-ssot.mjs sync-to-context",
    "dev:seed": "node scripts/dev-seed.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "ui:validate": "python3 .ai/skills/features/ui/ui-system-bootstrap/scripts/ui_specctl.py --repo-root . validate",
    "ui:codegen": "python3 .ai/skills/features/ui/ui-system-bootstrap/scripts/ui_specctl.py --repo-root . codegen",
    "ui:guard": "node scripts/ui-governance-guard.mjs",
    "ui:governance": "pnpm ui:validate && pnpm ui:guard"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@willyu1007/web-workbench": "^0.4.1",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "prisma": "^6.2.0",
    "stylelint": "^17.13.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0"
  }
}
